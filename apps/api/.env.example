DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zolvex?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/zolvex_test?schema=public"
PORT=4000
ADMIN_2FA_ENCRYPTION_KEY="replace-with-64-hex-chars-32-bytes"
JWT_SECRET="replace-with-a-long-random-string"
SEED_SUPERADMIN_EMAIL="you@example.com"
SEED_SUPERADMIN_NAME="Your Name"
# Express "trust proxy" setting. Leave unset for local dev/direct connections
# (the default, and the safe choice -- trusting X-Forwarded-For from an
# untrusted network lets a client spoof req.ip and its own rate-limit bucket).
# Set this ONLY when the API sits behind a known reverse proxy/load balancer,
# to a value Express understands, e.g.:
#   TRUST_PROXY="loopback"   # trust only a proxy running on the same host
#   TRUST_PROXY="1"          # trust exactly one hop (e.g. a single LB in front)
# See https://expressjs.com/en/guide/behind-proxies.html
#
# apps/web's admin Route Handlers (the BFF proxy, see docs/superpowers/plans/
# 2026-08-28-gate-2-frontend-auth-ui.md) relay whatever X-Forwarded-For value
# THEY received on the incoming browser request straight through to this API,
# unmodified. That relay is only safe to trust here -- i.e. TRUST_PROXY should
# only ever be set to "loopback" for this Next.js-in-front-of-Express layout
# -- if apps/web itself sits behind a real reverse proxy/CDN/load balancer
# that OVERWRITES (not appends to) any client-supplied X-Forwarded-For with
# the true connecting address before Next.js ever sees the request. If
# apps/web is directly internet-facing with nothing in front of it, a client
# can set X-Forwarded-For to anything it likes on every request and get a
# fresh rate-limit bucket each time -- do NOT set TRUST_PROXY in that case;
# leave it unset and rely on the per-account lockout (Admin.lockedUntil) as
# the brute-force defense instead.
# TRUST_PROXY="loopback"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
